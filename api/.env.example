PORT=3000

# Azure SQL
SQL_SERVER=your-server.database.windows.net
SQL_DATABASE=fastfreight
SQL_USER=ffu_app
SQL_PASSWORD=replace_me

# Azure Blob Storage (used to issue SAS for audit photos)
AZURE_STORAGE_ACCOUNT=ffustorage
AZURE_STORAGE_KEY=replace_me
AZURE_BLOB_CONTAINER=audits

# Azure Web PubSub / SignalR (parent dashboard real-time channel)
WEB_PUBSUB_CONNECTION_STRING=Endpoint=https://...;AccessKey=...;
WEB_PUBSUB_HUB=logistics

# Microsoft Entra ID (Azure AD) — token validation
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_AUDIENCE=api://your-api-app-id
